{
  "name": "ecardfactory-console-fallback",
  "private": true,
  "version": "1.0.0",
  "description": "Legacy fallback build bridge for the extracted content_engine_ui app",
  "scripts": {
    "build:console": "npm --prefix ../content_engine_ui run build:legacy-fallback",
    "build:console:dev": "npm --prefix ../content_engine_ui run build:legacy-fallback -- --sourcemap",
    "watch:console": "npm --prefix ../content_engine_ui run build:legacy-fallback -- --sourcemap --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "htm": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  }
}
