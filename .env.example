DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecard_factory
RAILWAY_DATABASE_URL=
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk-your-groq-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info
DB_SCHEMA=ecard_factory
WORKFLOW_MEMORY_FALLBACK_ENABLED=false
CONTENTFORGE_ENABLED=true
CONTENTFORGE_BASE_URL=http://127.0.0.1:8001
CONTENTFORGE_TIMEOUT_SECONDS=180
CONTENTFORGE_MODELS=qwen2.5:7b-instruct,llama3.1:8b,mistral:7b
IMAGE_PROVIDER=local_sdxl
IMAGE_CANDIDATES_PER_RUN=3
ASSET_STORAGE_BACKEND=filesystem
ASSET_STORAGE_ROOT=/Volumes/Ari_SSD_01/ecardfactory-assets
ASSET_PUBLIC_BASE_URL=http://localhost:8080/assets
